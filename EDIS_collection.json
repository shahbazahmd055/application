  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const CryptoJS = require('crypto-js');\r",
          "\r",
          "let secretToken = pm.collectionVariables.get(\"secretToken\");\r",
          "if (!secretToken) {\r",
          "    secretToken = pm.environment.get(\"secretToken\");\r",
          "}\r",
          "\r",
          "if (!secretToken || secretToken.length < 48) {\r",
          "    throw new Error(\"secretToken must be at least 48 characters (16 IV + 32 Key)\");\r",
          "}\r",
          "\r",
          "const iv  = CryptoJS.enc.Utf8.parse(secretToken.substring(0, 16));\r",
          "const key = CryptoJS.enc.Utf8.parse(secretToken.substring(16, 48));\r",
          "\r",
          "if (pm.request.body && pm.request.body.mode === \"raw\") {\r",
          "    const rawBody = pm.request.body.raw;\r",
          "\r",
          "    if (rawBody && rawBody.trim() !== \"\") {\r",
          "        const encrypted = CryptoJS.AES.encrypt(\r",
          "            rawBody,\r",
          "            key,\r",
          "            {\r",
          "                iv: iv,\r",
          "                mode: CryptoJS.mode.CBC,\r",
          "                padding: CryptoJS.pad.Pkcs7\r",
          "            }\r",
          "        ).toString();\r",
          "\r",
          "        // Send the encrypted string directly as raw body\r",
          "        pm.request.body.raw = encrypted;\r",
          "    }\r",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const CryptoJS = require('crypto-js');\r",
          "\r",
          "// Read response\r",
          "const responseText = pm.response.text().trim();\r",
          "\r",
          "// Detect plain JSON\r",
          "if (responseText.startsWith(\"{\") || responseText.startsWith(\"[\")) {\r",
          "    showJson(JSON.parse(responseText));\r",
          "    return;\r",
          "}\r",
          "\r",
          "// Get secret\r",
          "const secretToken =\r",
          "    pm.collectionVariables.get(\"secretToken\");\r",
          "\r",
          "if (!secretToken || secretToken.length < 48) {\r",
          "    throw new Error(\"secretTokens missing or invalid\");\r",
          "}\r",
          "\r",
          "// Build key & IV\r",
          "const iv  = CryptoJS.enc.Utf8.parse(secretToken.substring(0, 16));\r",
          "const key = CryptoJS.enc.Utf8.parse(secretToken.substring(16, 48));\r",
          "\r",
          "// Decrypt\r",
          "const decrypted = CryptoJS.AES.decrypt(responseText, key, {\r",
          "    iv: iv,\r",
          "    mode: CryptoJS.mode.CBC,\r",
          "    padding: CryptoJS.pad.Pkcs7\r",
          "});\r",
          "\r",
          "const decryptedText = decrypted.toString(CryptoJS.enc.Utf8);\r",
          "\r",
          "if (!decryptedText) {\r",
          "    throw new Error(\"Decryption failed\");\r",
          "}\r",
          "\r",
          "const json = JSON.parse(decryptedText);\r",
          "\r",
          "// Optional: store if needed later\r",
          "pm.collectionVariables.set(\"decryptedResponse\", JSON.stringify(json));\r",
          "\r",
          "showJson(json);\r",
          "\r",
          "// ---------- helper ----------\r",
          "function showJson(json) {\r",
          "    pm.visualizer.set(`\r",
          "        <style>\r",
          "            body {\r",
          "                font-family: Consolas, monospace;\r",
          "                background: #1e1e1e;\r",
          "                color: #d4d4d4;\r",
          "                padding: 12px;\r",
          "            }\r",
          "            pre {\r",
          "                white-space: pre-wrap;\r",
          "                word-break: break-word;\r",
          "                font-size: 13px;\r",
          "            }\r",
          "        </style>\r",
          "        <pre>{{json}}</pre>\r",
          "    `, {\r",
          "        json: JSON.stringify(json, null, 2)\r",
          "    });\r",
          "}\r",
          ""
        ]
      }
    }
